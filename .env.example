# Configuration de l'Agent d'Apprentissage de Langue

# ============================================
# AI Provider Configuration
# ============================================
# Choisissez votre provider: "groq" (GRATUIT) ou "openai"
AI_PROVIDER=groq

# ============================================
# Groq Configuration (GRATUIT - RECOMMANDÉ)
# ============================================
# Obtenez une clé gratuite sur: https://console.groq.com/keys
# 14,400 requêtes/jour GRATUITES !
GROQ_API_KEY=votre_clé_groq_ici
# Modèles Groq disponibles (gratuits):
# - llama-3.3-70b-versatile (recommandé, rapide et intelligent)
# - llama3-70b-8192
# - mixtral-8x7b-32768
MODEL_NAME=llama-3.3-70b-versatile

# ============================================
# OpenAI Configuration (Optionnel, payant)
# ============================================
# Obtenez votre clé sur: https://platform.openai.com/api-keys
# OPENAI_API_KEY=votre_clé_api_ici
# MODEL_NAME=gpt-4o-mini

# Température du modèle (0.0 à 2.0, optionnel)
TEMPERATURE=0.7

# Nombre maximum de tokens par réponse (optionnel)
MAX_TOKENS=1000

# ============================================
# Telegram Bot Configuration (Pour telegram_bot.py)
# ============================================
# Obtenez un token via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=8293037073:AAFECjc3rvU6vGzFzXxcU2Q18fSkcixK8yc

# ============================================
# Configuration Générale
# ============================================
# Niveau par défaut (A1, A2, B1, B2, C1, C2)
DEFAULT_LEVEL=B1

# Dossier de données (optionnel)
DATA_DIR=./data

# ============================================
# Vocabulaire (Optionnel)
# ============================================
# Chemin vers un fichier de vocabulaire personnalisé (CSV ou JSON)
# Si non spécifié, utilise le vocabulaire par défaut
# VOCABULARY_FILE=./data/vocabulary.json
# VOCABULARY_FILE=./data/vocabulary.csv
